+// KoykStudio: Boost.Graph replaced by a small union-find with the same component numbering (components are
+// numbered in the order of their lowest vertex, as boost::connected_components numbers them).
+namespace koyk_graph
+{
+struct Graph
+{
+    std::vector<int> parent;
+};
+inline int add_vertex(Graph& g)
+{
+    g.parent.push_back(int(g.parent.size()));
+    return int(g.parent.size()) - 1;
+}
+inline int find(Graph& g, int v)
+{
+    while (g.parent[v] != v) {
+        g.parent[v] = g.parent[g.parent[v]];
+        v = g.parent[v];
+    }
+    return v;
+}
+inline void add_edge(int a, int b, Graph& g)
+{
+    a = find(g, a);
+    b = find(g, b);
+    if (a != b) {
+        g.parent[a < b ? b : a] = a < b ? a : b;
+    }
+}
+inline size_t num_vertices(const Graph& g)
+{
+    return g.parent.size();
+}
+inline int connected_components(Graph& g, int* out)
+{
+    std::map<int, int> ids;
+    for (int v = 0; v < int(g.parent.size()); v++) {
+        int r = find(g, v);
+        auto it = ids.find(r);
+        if (it == ids.end()) {
+            it = ids.emplace(r, int(ids.size())).first;
+        }
+        out[v] = it->second;
+    }
+    return int(ids.size());
+}
+}  // namespace koyk_graph
 
